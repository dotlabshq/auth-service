# auth owns no DB — only a cache for OIDC/CLI transient state. The KV binding
# defaults to CACHE; @baseworks/sdk resolves it from KV_CACHE_URL (or CACHE_URL).
KV_CACHE_URL=redis://127.0.0.1:6379
PORT=3003
NODE_ENV=development

# JWT_SECRET — the shared realm secret auth signs oidc_token with (every
# consumer verifies with the same value).
JWT_SECRET=dev-secret-change-me-32-chars-min

# IAM delegation (optional). Set to register identities with iam-service; absent
# = login-only (the OIDC subject is the identity). Injected by a service binding
# in production — never hardcode a platform endpoint.
# IAM_SERVICE_URL=http://localhost:3000

# OIDC (Zitadel)
OIDC_ISSUER=https://nesskey.com
OIDC_CLIENT_ID=<your-pkce-client-id>
# OIDC_CLIENT_SECRET=   # PKCE flow — not needed
OIDC_SCOPE=openid profile email offline_access

# Public URL of the realm as the browser sees it (the OIDC callback and the CLI
# login URL are derived from it). Behind a gateway this is the gateway's origin,
# not this service's port.
APP_PUBLIC_URL=http://localhost:3003

# Where `GET /start` sends a person to approve a CLI sign-in. Unset, this
# service serves its own bare page at APP_PUBLIC_URL/v1/auth/token. A realm with
# a console points this at that console's approve screen instead.
# AUTH_CLI_APPROVE_URL=http://localhost:8080/approve

# Cookie domain for cross-subdomain SSO (e.g. .yourdomain.com)
# OIDC_COOKIE_DOMAIN=

# Where a sign-in or sign-out may send the browser afterwards. A path is always
# allowed; an absolute URL only if its origin is APP_PUBLIC_URL or listed here.
# Without this, ?returnTo=https://evil.example is an open redirect: the person
# signs in for real and lands somewhere else.
AUTH_RETURN_ORIGINS=http://localhost:3200,http://doubletap.localhost:8080

# NOT OIDC_COOKIE_DOMAIN. `Domain=localhost` does not work: a browser rejects a
# cookie domain that is a single label with no dot — it would be a supercookie
# over a whole TLD — so the attribute is dropped and the cookie stays host-only.
# Verified in the browser: set on localhost, not sent to doubletap.localhost.
#
# Which is why a product shares the session by sharing the HOST and differing
# only in PORT (cookies ignore the port), not by taking a hostname of its own.
# A product on its own hostname needs the one-time ticket handoff, which is not
# built yet — see product ADR 0001 §8 and its open item.

# Key for the session cookie's signature. Unset, it is derived from JWT_SECRET,
# else from AUTH_SIGNING_KEY — and changing that one signs every browser out.
# Set this to keep sessions alive across a key rotation.
# AUTH_SESSION_SECRET=
